-- allium: 3
-- dside-events: event discovery for Athens. Text-only events posted by
-- whitelisted curators ("posters"); attendees hold anonymous accounts that
-- start in a cookie on their first Follow of an event and travel
-- to another device through a secret link. No email, no sign-up. Anonymous visitors browse.
-- Source of truth for product intent: PROJECT.md.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- Anyone reaching the public boundary: a browser, with or without a valid
-- session cookie. Governed by the browser and the network, not by this
-- specification; the session it presents is all we know about it.
external entity Visitor {
    session: Session?                       -- the active session named by the cookie, absent otherwise
    theme: light | dark | null           -- explicit choice kept in a cookie; null follows the system
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Link {
    url: String               -- absolute http or https URL
    label: String?            -- shown instead of the URL when present
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Role { user | poster }

-- 2026-09-06: the founder renamed the event action from "interested" /
-- "not interested" to "follow" / "hide"; this enum was InterestState
-- { interested | not_interested } and the entity below was Interest.
enum FollowState { following | hidden }

enum Tag { concert | theater | film | exhibition }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Account {
    -- Fields
    key: String                             -- the secret-link credential: config.key_length random bytes, base64url; the only identifier the account has
    role: Role
    name: String when role = poster         -- public curator name, the trust signal
    slug: String when role = poster         -- public curator identifier
    created_at: Timestamp

    -- The role is fixed at creation: users start themselves, posters are
    -- added by the operator. Nothing promotes one into the other.
    transitions role {
        terminal: user, poster
    }

    -- Relationships
    sessions: Session with account = this
    events: Event with poster = this
    event_follows: EventFollow with account = this

    -- Projections
    active_sessions: sessions where status = active
    followed_events: event_follows where state = following -> event
    hidden_events: event_follows where state = hidden -> event

    -- Derived
    is_poster: role = poster
}

entity Session {
    -- Fields
    account: Account
    status: active | expired
    created_at: Timestamp
    expires_at: Timestamp

    transitions status {
        active -> expired
        terminal: expired
    }
}

entity Event {
    -- Fields
    poster: Account
    slug: String                            -- immutable public identifier, unique across all events
    title: String
    description: String                     -- plain text
    starts_at: Timestamp                    -- a moment; displayed in Europe/Athens
    venue: String
    price: String?                          -- free text such as "10 EUR" or "free"
    tags: Set<Tag>
    links: List<Link>
    created_at: Timestamp
    updated_at: Timestamp
    series_id: Integer?                     -- shared by every date of a repeating post; absent for a single event

    -- Relationships
    follows: EventFollow with event = this
    series: Event with series_id = this.series_id when series_id != null

    -- Projections
    followed_by: follows where state = following

    -- Derived
    follower_count: followed_by.count
    series_count: series.count              -- 0 for a single event; the dates still posted, this one included
    is_upcoming: starts_at >= athens_day_start(now)    -- black box: midnight in Europe/Athens of the current day

    invariant PostedByPoster {
        poster.is_poster
    }
}

entity EventFollow {
    -- Fields
    account: Account
    event: Event
    state: FollowState
    updated_at: Timestamp
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    session_duration: Duration = 365.days
    key_length: Integer = 32                -- random bytes in a secret key
    max_tags: Integer = 4
    max_links: Integer = 3
    max_title_length: Integer = 120
    max_description_length: Integer = 4000
    max_venue_length: Integer = 120
    max_price_length: Integer = 60
    max_past_start: Duration = 1.year       -- how far in the past an event may start
    max_future_start: Duration = 3.years    -- how far in the future an event may start
    max_link_url_length: Integer = 500
    max_link_label_length: Integer = 80
    home_list_size: Integer = 10            -- founder decision, deliberately not a setting: rows per home column
    max_series_occurrences: Integer = 200   -- dates one repeating post may create; a season of 4 nights a week for 8 months is about 140
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Accounts and sessions -----------------------------------

-- An account starts on the visitor's first Follow of an event
-- or first Hide. The surfaces that offer those actions to a visitor without
-- a session offer StartAccount alongside them; the implementation performs
-- both in the same request.
rule StartAccount {
    when: StartAccount(visitor)
    requires: visitor.session = null
    ensures:
        let account = Account.created(
            role: user,
            key: random_key(config.key_length),              -- black box: config.key_length random bytes, base64url
            created_at: now
        )
        let session = Session.created(
            account: account,
            status: active,
            created_at: now,
            expires_at: now + config.session_duration
        )
        SessionIssued(visitor: visitor, session: session)
    @guidance
        -- HTTP: fired by POST /e/{slug}/follow when the request carries no
        -- valid session cookie; the event-follow rule then applies to the new
        -- account in the same request, and the
        -- response is the same 303 an existing account gets. SessionIssued is
        -- the Set-Cookie: session cookie, HttpOnly, SameSite=Lax, Path=/,
        -- Secure when configured, config.session_duration long. No other
        -- request creates an account; read pages never do.
}

rule OpenSecretLink {
    when: OpenSecretLink(visitor, key)
    let account = Account{key: key}
    requires: exists account
    ensures:
        let session = Session.created(
            account: account,
            status: active,
            created_at: now,
            expires_at: now + config.session_duration
        )
        SessionIssued(visitor: visitor, session: session)
    @guidance
        -- HTTP: GET /k/{key}. Success sets the session cookie and answers 303
        -- to /mine; this is also how posters log in. A key no account holds
        -- fires no rule and answers 404 with "This link doesn't work. It may
        -- have been replaced with a new one." A visitor who already carries a
        -- session cookie switches to the link's account; the earlier session
        -- row is left to expire.
}

rule RotateSecretLink {
    when: RotateSecretLink(account)
    ensures: account.key = random_key(config.key_length)
    @guidance
        -- HTTP: POST /account/key, 303 to /account. The old link stops working
        -- at once; existing sessions, including the one making the request,
        -- are untouched. Without a session the request answers 303 to /account.
}

rule ForgetDevice {
    when: ForgetDevice(session)
    requires: session.status = active
    ensures: not exists session
    @guidance
        -- HTTP: POST /forget removes the session row named by the cookie and
        -- clears the cookie, then 303 to /. The account and everything in it
        -- stay; the secret link brings it back. Without a session the request
        -- answers 303 to /account. GET /forget answers 405.
}

rule SessionExpires {
    when: session: Session.expires_at <= now
    requires: session.status = active
    ensures: session.status = expired
    @guidance
        -- An expired session is indistinguishable from a missing one at the
        -- boundary; the implementation may delete the row instead of keeping it.
}

-- Curator onboarding (operator CLI, no web surface) ------

rule AddPoster {
    when: AddPoster(name, slug?)
    let chosen = slug ?? poster_slug(name)                   -- black box: ASCII slug from the name
    requires: not exists Account{role: poster, slug: chosen}
    ensures: Account.created(
        role: poster,
        key: random_key(config.key_length),
        name: name,
        slug: chosen,
        created_at: now
    )
    @guidance
        -- CLI: dside-events add-poster -name "Maria P." [-slug maria]. Prints
        -- two lines, "poster <slug>" and "link <BASE_URL>/k/<key>"; the link
        -- is the poster's login. Works while the server runs. Re-running for
        -- an existing slug fires no rule: it prints "poster <slug>" and
        -- "link (unchanged, run poster-link to get a new one)".
}

rule RotatePosterLink {
    when: RotatePosterLink(slug)
    let account = Account{role: poster, slug: slug}
    requires: exists account
    ensures: account.key = random_key(config.key_length)
    @guidance
        -- CLI: dside-events poster-link -slug maria. Prints
        -- "link <BASE_URL>/k/<key>". An unknown slug fires no rule and exits
        -- with an error. Sessions the poster already holds are untouched.
}

-- Events --------------------------------------------------

rule CreateEvent {
    when: CreateEvent(poster, title, starts_at, venue, price?, description, tags, links)
    requires: poster.is_poster
    requires: length(title) >= 1 and length(title) <= config.max_title_length
    requires: length(venue) >= 1 and length(venue) <= config.max_venue_length
    requires: price = null or length(price) <= config.max_price_length
    requires: length(description) <= config.max_description_length
    requires: starts_at >= now - config.max_past_start and starts_at <= now + config.max_future_start
    requires: tags.count >= 1 and tags.count <= config.max_tags
    requires: links.count <= config.max_links
    requires: links.all(l => valid_http_url(l.url))          -- black box: http(s) scheme with a host
    requires: links.all(l => length(l.url) <= config.max_link_url_length)
    requires: links.all(l => l.label = null or length(l.label) <= config.max_link_label_length)
    -- One post per event: no other event by this poster with the same normalised
    -- title on the same Athens day.
    requires: not poster.events.any(e =>
        normalise_title(e.title) = normalise_title(title)    -- black box: trim, collapse spaces, case-fold
        and athens_day(e.starts_at) = athens_day(starts_at)) -- black box: calendar day in Europe/Athens
    ensures: Event.created(
        poster: poster,
        slug: unique_slug(title, starts_at),                 -- black box: transliterated title + Athens date suffix, made unique
        title: title,
        description: description,
        starts_at: starts_at,
        venue: venue,
        price: price,
        tags: tags,
        links: links,
        created_at: now,
        updated_at: now
    )
    @guidance
        -- HTTP: GET/POST /new for posters only; a user or an anonymous visitor
        -- gets 403. Form fields title, date, time, venue, price, tag
        -- (repeated), link_label_1..3, link_url_1..3, description; date and
        -- time are read in Europe/Athens. A link without label defaults its
        -- label to the URL host. Success 303 to /e/{slug}; any failed
        -- requirement 422 re-rendering the form with the submitted values, the
        -- duplicate case saying "already posted".
}

-- A repeating post is many ordinary events sharing a series id. Nothing else
-- is shared: each date has its own slug, is edited and deleted on its own.
rule CreateSeries {
    when: CreateSeries(poster, title, first_date, until, weekdays, times, venue, price?, description, tags, links)
    -- Black box: each day from first_date to until inclusive whose weekday is
    -- in weekdays, at each of times, read in Europe/Athens, ascending. The
    -- weekday of first_date itself need not be in weekdays.
    let starts = series_starts(first_date, until, weekdays, times)
    requires: poster.is_poster
    requires: until >= first_date
    requires: weekdays.count >= 1 and times.count >= 1
    requires: starts.count >= 2 and starts.count <= config.max_series_occurrences
    requires: starts.all(s => s >= now - config.max_past_start and s <= now + config.max_future_start)
    requires: length(title) >= 1 and length(title) <= config.max_title_length
    requires: length(venue) >= 1 and length(venue) <= config.max_venue_length
    requires: price = null or length(price) <= config.max_price_length
    requires: length(description) <= config.max_description_length
    requires: tags.count >= 1 and tags.count <= config.max_tags
    requires: links.count <= config.max_links
    requires: links.all(l => valid_http_url(l.url))          -- black box: http(s) scheme with a host
    requires: links.all(l => length(l.url) <= config.max_link_url_length)
    requires: links.all(l => l.label = null or length(l.label) <= config.max_link_label_length)
    -- One post per event, checked against what the poster already has: no
    -- other event with the same normalised title on any Athens day this post
    -- covers. The dates of this post are not compared with one another, so
    -- two start times on one day are fine.
    requires: not poster.events.any(e =>
        normalise_title(e.title) = normalise_title(title)
        and starts.any(s => athens_day(e.starts_at) = athens_day(s)))
    ensures:
        let series = fresh_series_id()                       -- black box: an integer no event carries yet
        for s in starts:
            Event.created(
                poster: poster,
                slug: unique_slug(title, s),                 -- a second start on one Athens day gets the -2 suffix
                title: title,
                description: description,
                starts_at: s,
                venue: venue,
                price: price,
                tags: tags,
                links: links,
                series_id: series,
                created_at: now,
                updated_at: now
            )
    @guidance
        -- HTTP: POST /new with the CreateEvent fields plus repeats=1, weekday
        -- (repeated checkbox; mon tue wed thu fri sat sun), times (optional
        -- text, comma-separated HH:MM; empty means the time field alone) and
        -- until (YYYY-MM-DD). date is first_date and time stays required. The
        -- edit form never offers or reads these fields. Every date is inserted
        -- in one transaction; success 303 to /e/{slug} of the earliest date.
        -- Any failed requirement 422 re-rendering the form with the submitted
        -- values: weekday "Pick weekdays from the list." / "Pick at least one
        -- weekday."; times "Pick valid start times, like 18:00, 21:00." /
        -- "Each start time must be different."; until "Pick an until date." /
        -- "Pick a valid until date." / "Until must be on or after the date." /
        -- "Until must be within the next three years." / "A repeating event
        -- needs at least two dates." / "A repeating event can have at most
        -- 200 dates."; the duplicate case on title, "You already posted this
        -- event on 2 January 2027." naming the first covered day that clashes.
}

rule EditEvent {
    when: EditEvent(poster, event, title, starts_at, venue, price?, description, tags, links)
    requires: event.poster = poster
    requires: length(title) >= 1 and length(title) <= config.max_title_length
    requires: length(venue) >= 1 and length(venue) <= config.max_venue_length
    requires: price = null or length(price) <= config.max_price_length
    requires: length(description) <= config.max_description_length
    requires: starts_at >= now - config.max_past_start and starts_at <= now + config.max_future_start
    requires: tags.count >= 1 and tags.count <= config.max_tags
    requires: links.count <= config.max_links
    requires: links.all(l => valid_http_url(l.url))
    requires: links.all(l => length(l.url) <= config.max_link_url_length)
    requires: links.all(l => l.label = null or length(l.label) <= config.max_link_label_length)
    requires: not poster.events.any(e =>
        e != event
        and normalise_title(e.title) = normalise_title(title)
        and athens_day(e.starts_at) = athens_day(starts_at))
    ensures: event.title = title
    ensures: event.description = description
    ensures: event.starts_at = starts_at
    ensures: event.venue = venue
    ensures: event.price = price
    ensures: event.tags = tags
    ensures: event.links = links
    ensures: event.updated_at = now
    ensures: event.slug = event.slug                         -- the slug never changes, even when title or date do
    @guidance
        -- HTTP: GET/POST /e/{slug}/edit, prefilled. Owner only: another poster,
        -- a user or an anonymous visitor gets 403, unknown slug 404. Success
        -- 303 to the same /e/{slug}; failures 422 as for CreateEvent.
}

rule DeleteEvent {
    when: DeleteEvent(poster, event)
    requires: event.poster = poster
    ensures:
        for f in event.follows:
            not exists f
        not exists event
    @guidance
        -- HTTP: POST /e/{slug}/delete, owner only (403 otherwise), 303 to /.
        -- Hard delete: the slug answers 404 afterwards and is never reused.
}

-- Event follows ------------------------------------------

rule FollowEvent {
    when: FollowEvent(account, event)
    let members = if event.series_id = null then {event} else event.series   -- a press on one date acts on the whole run
    ensures:
        for m in members:
            let existing = EventFollow{account, m}
            if exists existing:
                existing.state = following
                existing.updated_at = now
            else:
                EventFollow.created(account: account, event: m, state: following, updated_at: now)
    @guidance
        -- HTTP: POST /e/{slug}/follow with state=follow and back; 303 to back
        -- when it is a local path, otherwise to /e/{slug}. Idempotent. Without
        -- a session StartAccount runs first in the same request. The follower
        -- count on an event is public. Following one date of a repeating
        -- event follows every date; each date's public count therefore reads
        -- the same.
}

rule HideEvent {
    when: HideEvent(account, event)
    let members = if event.series_id = null then {event} else event.series   -- a press on one date acts on the whole run
    ensures:
        for m in members:
            let existing = EventFollow{account, m}
            if exists existing:
                existing.state = hidden
                existing.updated_at = now
            else:
                EventFollow.created(account: account, event: m, state: hidden, updated_at: now)
    @guidance
        -- HTTP: same endpoint with state=hide; without a session StartAccount
        -- runs first. Never expose a hidden state to anyone but the owning
        -- account: not to other users, not to the poster, and never in the
        -- public count. Hiding one date hides every date of the run.
}

rule UnfollowEvent {
    when: UnfollowEvent(account, event)
    let members = if event.series_id = null then {event} else event.series   -- a press on one date acts on the whole run
    ensures:
        for m in members:
            not exists EventFollow{account, m}
    @guidance
        -- HTTP: same endpoint with state=clear. Removes the EventFollow
        -- whatever its state, so it both unfollows a followed event and shows a
        -- hidden one again. Any other state value answers 400; an unknown slug
        -- 404. Clearing when nothing is set is a no-op. Clearing one date
        -- clears every date, whatever its state.
}

-- Account -------------------------------------------------

rule ChooseTheme {
    when: ChooseTheme(visitor, theme)
    requires: theme in {light, dark, auto}
    ensures:
        if theme = auto:
            visitor.theme = null
        else:
            visitor.theme = theme
    @guidance
        -- HTTP: POST /theme with theme=light|dark|auto and back; a one-year
        -- cookie "theme", cleared by auto; 303 back. Any other value is 400.
        -- Every page carries one link-styled toggle in the header that offers
        -- the opposite of what is shown ("dark" when no choice is stored, a
        -- script flips it to "light" on a system already in dark); the page
        -- root gets data-theme so the choice overrides prefers-color-scheme.
}

rule DeleteAccount {
    when: DeleteAccount(account)
    requires: account.role = user
    ensures:
        for s in account.sessions:
            not exists s
        for f in account.event_follows:
            not exists f
        not exists account                                   -- the key goes with it: the secret link answers 404 afterwards
    @guidance
        -- HTTP: POST /account/delete requires confirm=1 (otherwise 422); a
        -- poster gets 403 with "Curator accounts are removed by hand"; success
        -- clears the cookie and 303 to /. Without a session the request
        -- answers 303 to /account. Follower counts on events drop
        -- accordingly. The next Follow from that browser starts a fresh,
        -- unrelated account.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SecretKeysUnique {
    for a in Accounts:
        for b in Accounts:
            a != b implies a.key != b.key
}

invariant PosterSlugsUnique {
    for a in Accounts:
        for b in Accounts:
            a != b and a.role = poster and b.role = poster implies a.slug != b.slug
}

invariant SlugsUnique {
    for a in Events:
        for b in Events:
            a != b implies a.slug != b.slug
}

invariant OneFollowPerAccountEvent {
    for a in EventFollows:
        for b in EventFollows:
            a != b implies not (a.account = b.account and a.event = b.event)
}

-- Follow, hide and clear act on a whole run, so no account can be in two
-- minds about the dates of one repeating post.
invariant SeriesFollowStateUniform {
    for a in Events:
        for b in Events:
            a != b and a.series_id != null and a.series_id = b.series_id implies
                a.follows.all(f => b.follows.any(g => g.account = f.account and g.state = f.state))
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Visitors face the public surfaces as the external entity Visitor directly:
-- the same surface serves a browser with and without a session, and the
-- session is optional. Only curators need a dedicated actor.
actor Poster {
    identified_by: Account where role = poster and active_sessions.count > 0
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Home {
    facing visitor: Visitor

    let account = visitor.session?.account                   -- absent without a session
    let upcoming = Events where is_upcoming
    -- Upcoming events minus the ones this account hid; without an account
    -- nothing is hidden.
    let visible = upcoming where not follows.any(f => f.account = account and f.state = hidden)
    -- The next config.home_list_size of them, soonest first. A tag filter
    -- narrows visible before the cut (see FilterableByTag on UpcomingAll).
    let upcoming_next = first_n(visible, config.home_list_size)      -- black box: the first n in ascending starts_at
    -- The visitor's upcoming followed events, soonest first, at most
    -- config.home_list_size; empty without a session. The same tag filter
    -- narrows this column too, so both columns always show the same tag.
    let mine_next = first_n(upcoming where follows.any(f => f.account = account and f.state = following), config.home_list_size)

    exposes:
        for e in upcoming_next:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.price
            e.follower_count
            e.series_count
            e.tags
            e.poster.name
            e.poster.slug
        for e in mine_next:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.price
            e.follower_count
            e.series_count
            e.tags
            e.poster.name
            e.poster.slug

    provides:
        StartAccount(visitor) when visitor.session = null
        for e in upcoming_next:
            FollowEvent(account, e)
                when account != null and not e.follows.any(f => f.account = account and f.state = following)
            HideEvent(account, e)
                when account != null
            UnfollowEvent(account, e)
                when account != null and e.follows.any(f => f.account = account and f.state = following)
        for e in mine_next:
            UnfollowEvent(account, e)                        -- every row of My feed is followed by construction

    related:
        for e in upcoming_next:
            EventDetail(e)
            PosterPage(e.poster)
        for e in mine_next:
            EventDetail(e)
            PosterPage(e.poster)
        UpcomingAll
        MyEvents when account != null

    @guarantee TenAtMost
        -- The home list never shows more than config.home_list_size events
        -- per column; the founder chose the number and it is not a setting.
        -- There is no pagination: the rest is one link away on UpcomingAll.
    -- 2026-09-06: the founder renamed the column from "Mine" to "My feed" and
    -- ruled that it always renders. It used to appear only with a session and
    -- at least one upcoming followed event, which meant an anonymous visitor
    -- never learned the column existed, the first Follow inserted a column
    -- above the visitor's scroll position, and a tag filter that emptied the
    -- column deleted it mid-session. The empty column now carries the copy
    -- instead, which is also where a visitor without a session is told what
    -- Follow costs.
    @guarantee SideBySide
        -- My feed and Upcoming are two columns of one screen, My feed first.
        -- Both columns always render; an empty My feed states why it is empty
        -- rather than being omitted.
    @guidance
        -- HTTP: GET / and GET /?tag={tag}, 200 with or without a session;
        -- unknown tag 404. The filters row (all · one link per Tag) spans the
        -- full width above both columns and narrows both. With script, a
        -- press on a row re-renders both columns from the response, so a
        -- followed event appears in My feed at once, and focus returns to the
        -- control that was pressed; without script the page reloads to the
        -- same result. Column My feed: heading "My feed", the rows of
        -- mine_next grouped by Athens day, then the link "All of my feed →"
        -- to /mine, shown once the visitor has an account. With no rows the
        -- column carries one line instead: without a session, "Follow an
        -- event and it starts a list on this device. No sign-up, no email.";
        -- with a session, "Nothing here yet. Follow an event and it shows up
        -- here.", or "Nothing of yours tagged {tag}." under a filter.
        -- Column Upcoming: heading "Upcoming", the rows of
        -- upcoming_next grouped by Athens day, then the link "All upcoming
        -- events →" to /upcoming (carrying ?tag= when filtered); that link is
        -- shown even when the list is empty, under the usual empty copy. The
        -- columns sit side by side when the screen has room and stack, My
        -- feed first, when it does not. Every row carries the Follow toggle and a plain Hide link-button (a hidden event leaves the list at once),
        -- labelled "Follow" until pressed, then "Following" with a check mark
        -- drawn by the stylesheet (aria-pressed) when the account follows the
        -- event; a press without a session fires StartAccount and then
        -- FollowEvent in the same request. Hide keeps the link accent and a
        -- target no smaller than the text it sits under, because it cannot be
        -- undone from this surface. Days are visibly separated. The follower
        -- count is always shown as "{n} following", zero included (the founder
        -- fixed the row as five lines; on 2026-09-06 he ruled their order as
        -- title, tags, "venue, price", "{n} following", curator, so the count
        -- no longer sits directly under the curator's name and the name ends
        -- the row). Filters are plain text links. Pages are served with
        -- Cache-Control: no-store.

}

surface UpcomingAll {
    facing visitor: Visitor

    let account = visitor.session?.account                   -- absent without a session
    let upcoming = Events where is_upcoming
    -- Upcoming events minus the ones this account hid; without an account
    -- nothing is hidden.
    let visible = upcoming where not follows.any(f => f.account = account and f.state = hidden)

    exposes:
        for e in visible:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.price
            e.follower_count
            e.series_count
            e.tags
            e.poster.name
            e.poster.slug

    provides:
        StartAccount(visitor) when visitor.session = null
        -- Every row carries the Follow toggle and a plain Hide link-button (a hidden event leaves the list at once).
        for e in visible:
            FollowEvent(account, e)
                when account != null and not e.follows.any(f => f.account = account and f.state = following)
            HideEvent(account, e)
                when account != null
            UnfollowEvent(account, e)
                when account != null and e.follows.any(f => f.account = account and f.state = following)

    related:
        for e in visible:
            EventDetail(e)
            PosterPage(e.poster)

    @guarantee UpcomingOnly
        -- Only events on or after the current Athens day appear; past events
        -- stay reachable through their own page but never through the feed.
    @guarantee FilterableByTag
        -- The feed can be narrowed to events carrying one tag from the Tag
        -- enumeration. A tag outside the enumeration is not a feed at all.
    @guarantee HiddenStaysHidden
        -- An event the account hid does not appear until the hide is
        -- cleared; nobody else can tell it was hidden.
    @guidance
        -- HTTP: GET /upcoming and GET /upcoming?tag={tag} render every event
        -- in visible under the heading "Upcoming", unknown tag 404. Both
        -- answer 200 with or without a session. The filter row is Home's,
        -- except that its all and tag links stay on /upcoming. Events are
        -- grouped by Athens day in ascending start order; the follower count
        -- is always shown, zero
        -- included. Every row carries the Follow toggle and a plain Hide link-button (a hidden event leaves the list at once), pressed when the
        -- account follows the event; a press without a session fires
        -- StartAccount and then FollowEvent in the same request. This is the whole list
        -- Home links to: no row limit, no pagination. Filters are plain text
        -- links. Pages are served with Cache-Control: no-store.

}

surface EventDetail {
    facing visitor: Visitor

    context event: Event

    let account = visitor.session?.account                   -- absent without a session
    let mine = EventFollow{account: account, event: event}   -- absent without a session or a follow

    exposes:
        event.slug
        event.title
        event.starts_at
        event.venue
        event.price
        event.tags
        event.links
        event.description
        event.poster.name
        event.poster.slug
        event.follower_count
        event.series_count
        event.is_upcoming
        mine.state when exists mine

    provides:
        StartAccount(visitor)
            when visitor.session = null and event.is_upcoming
        FollowEvent(account, event)
            when account != null and event.is_upcoming and (not exists mine or mine.state = hidden)
        HideEvent(account, event)
            when account != null and event.is_upcoming and (not exists mine or mine.state = following)
        UnfollowEvent(account, event)
            when account != null and exists mine and event.is_upcoming
        DeleteEvent(account, event)
            when event.poster = account

    related:
        PosterPage(event.poster)
        EventEditor(event)
            when event.poster = account

    @guarantee SlugImmutable
        -- The event URL never changes after creation, including across edits.
    @guarantee PosterIsPublic
        -- Every event page names the curator who posted it and links to
        -- their page; the name is the trust signal.
    @guarantee HiddenIsPrivate
        -- The hidden state is shown only to the account that set it, as
        -- "Hidden from Upcoming." with a clear action; the public count
        -- never includes it. (2026-09-06: was "Hidden from your feed."
        -- until the My feed rename gave "feed" a single meaning; hiding
        -- keeps an event out of Upcoming, not out of My feed.)
    @guidance
        -- HTTP: GET /e/{slug}; unknown slug 404. The page is identical with
        -- and without a session: two toggle buttons post to /e/{slug}/follow
        -- with a hidden back field: one labelled "Follow" until pressed, then
        -- "Following" (state=follow, pressed state=clear), one labelled "Hide"
        -- until pressed, then "Hidden" (state=hide, pressed state=clear); both
        -- carry aria-pressed. The counter reads "{n} following", and at zero
        -- is not shown at all (founder, 2026-09-06: nobody yet is not news,
        -- and a zero beside a curator's name reads as a score); on a past
        -- event "{n} followed", likewise absent at zero (formerly "Nobody
        -- following yet" / "Nobody followed").
        -- A press without a session fires StartAccount and then
        -- the event-follow rule in the same request. A past event shows
        -- "This event has passed." and no buttons.
        -- The owner sees an Edit link and a Delete form. Toggles are plain
        -- forms that work without script; script only replaces the form in
        -- place. Tags link to /?tag=, external links open the given URLs.

}

surface PosterPage {
    facing visitor: Visitor

    context curator: Account where role = poster

    let account = visitor.session?.account                   -- absent without a session
    let upcoming = curator.events where is_upcoming
    let past = curator.events where not is_upcoming

    exposes:
        curator.name
        curator.slug
        for e in upcoming:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.price
            e.follower_count
            e.series_count
            e.tags
            e.poster.name
            e.poster.slug
        for e in past:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.follower_count

    provides:
        StartAccount(visitor) when visitor.session = null
        for e in upcoming:
            FollowEvent(account, e)
                when account != null and not e.follows.any(f => f.account = account and f.state = following)
            HideEvent(account, e)
                when account != null
            UnfollowEvent(account, e)
                when account != null and e.follows.any(f => f.account = account and f.state = following)

    related:
        for e in upcoming:
            EventDetail(e)
            PosterPage(e.poster)
        for e in past:
            EventDetail(e)

    @guidance
        -- HTTP: GET /p/{slug}; a slug that is not a poster's answers 404.
        -- Upcoming ascending, then Past descending. Upcoming rows carry the
        -- Follow toggle; past rows carry none and read "{n} followed" when the
        -- count is not zero. A press without a session fires StartAccount and
        -- then FollowEvent in the same request.

}

surface MyEvents {
    facing visitor: Visitor

    let account = visitor.session?.account                   -- absent without a session
    let followed = Events where follows.any(f => f.account = account and f.state = following)
    let upcoming = followed where is_upcoming
    let past = followed where not is_upcoming
    let hidden = Events where follows.any(f => f.account = account and f.state = hidden)

    exposes:
        for e in upcoming:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.price
            e.follower_count
            e.series_count
            e.tags
            e.poster.name
            e.poster.slug
        for e in past:
            e.slug
            e.title
            e.starts_at
            e.venue
            e.follower_count
        for e in hidden:
            e.slug
            e.title
            e.starts_at
            e.venue

    provides:
        -- The same row toggle as every list. Every row of Upcoming is followed
        -- by construction, so only the unfollowing side is ever offered.
        for e in upcoming:
            FollowEvent(account, e)
                when not e.follows.any(f => f.account = account and f.state = following)
            HideEvent(account, e)
                when account != null
            UnfollowEvent(account, e)
                when e.follows.any(f => f.account = account and f.state = following)
        for e in hidden:
            UnfollowEvent(account, e)

    related:
        for e in upcoming:
            EventDetail(e)
            PosterPage(e.poster)
        for e in past:
            EventDetail(e)
        for e in hidden:
            EventDetail(e)

    @guarantee UndoWithoutScript
        -- A hidden event can always be restored from this page with a plain
        -- form post, so hiding is never a dead end.
    @guidance
        -- HTTP: GET /mine, 200 with or without a session, with sections
        -- Upcoming (ascending), Past (descending) and Hidden; upcoming rows
        -- carry the Follow toggle, shown pressed, and pressing it unfollows;
        -- past rows carry none. Hidden carries the note "Events you hid. They
        -- stay out of Upcoming." and a "Show again" button (state=clear) per
        -- row. The Upcoming heading appears only when at least one upcoming
        -- event is followed; the empty state "Nothing here yet. Follow an
        -- event and it shows up here." appears when the account has no event
        -- follow at all, neither following nor hidden, and when there is no
        -- session.

}

surface AccountPage {
    facing visitor: Visitor

    let account = visitor.session?.account                   -- absent without a session

    exposes:
        account.key when account != null
        account.role when account != null
        account.slug when account != null and account.role = poster

    provides:
        RotateSecretLink(account) when account != null
        ForgetDevice(visitor.session) when visitor.session != null
        DeleteAccount(account) when account != null and account.role = user

    @guarantee CuratorsRemovedByHand
        -- A poster account cannot delete itself; the page says so instead of
        -- offering the form.
    @guarantee NoPersonalData
        -- The account stores no email, name or identifier beyond the random
        -- key; the page has nothing personal to show and asks for nothing.
    @guarantee CrossSiteWritesRejected
        -- The session cookie issued by StartAccount and OpenSecretLink is
        -- SameSite=Lax, so a browser attaches it to top-level navigations
        -- only. Every state-changing request (any method other than GET or
        -- HEAD, on every surface) is refused when the browser's Sec-Fetch-Site
        -- header says cross-site; when that header is absent the Origin, else
        -- the Referer, must name this host when present. A request carrying
        -- none of the three headers is accepted, and OPTIONS is exempt. No
        -- per-form token is used. GET /k/{key} is the deliberate exception
        -- (see SecretLink).
    @guidance
        -- HTTP: GET /account, 200 in two states. Without a session: "This
        -- device has no list yet. Follow an event and your account starts
        -- here. No sign-up, no email." and "Opened a
        -- secret link before? Open it again on this
        -- device to continue there." With a session: "Your secret link" as an
        -- absolute /k/{key} URL with "Open it on another device to see the
        -- same list there. Anyone with this link is you, so keep it to
        -- yourself." and a "Get a new link" form (hint "The old link stops
        -- working."); "This device" with a "Forget this device" form ("Your list stays;
        -- the secret link brings it back."); and, for users, "Delete account"
        -- with confirm=1 and the note "Deletes your account, your follows and
        -- your hidden events. It can't be undone." A poster sees a link to
        -- their own curator page and
        -- "Curator accounts are removed by hand. Ask us." instead of the
        -- delete form. Forget acts on the session carried by the request
        -- cookie.
}

surface SecretLink {
    facing visitor: Visitor

    provides:
        OpenSecretLink(visitor, key)

    @guidance
        -- HTTP: GET /k/{key}; the key is the last path segment. A held key
        -- issues a fresh session and answers 303 to /mine, replacing whatever
        -- session cookie the browser carried; a key nobody holds answers 404
        -- with "This link doesn't work. It may have been replaced with a new
        -- one." The link is the only way to reach an account from a second
        -- device and the only way posters log in.
        -- This GET changes state on purpose: links arrive from chat or mail,
        -- always cross-site, so it is the one deliberate exception to
        -- CrossSiteWritesRejected. Opening someone else's link makes this
        -- device theirs; that is the feature, not a leak (see OQ-18).
}

surface EventComposer {
    facing curator: Poster

    provides:
        CreateEvent(curator, title, starts_at, venue, price?, description, tags, links)
        CreateSeries(curator, title, first_date, until, weekdays, times, venue, price?, description, tags, links)

    @guarantee OnePostPerEvent
        -- A second post with the same normalised title on an Athens day the
        -- curator already covers, by one event or by a date of a repeating
        -- one, is refused; the dates of a single repeating post do not count
        -- against each other. Editing is the only way to change a posted
        -- event.
    @guarantee TextOnly
        -- Events carry no images or video; external material is reached only
        -- through the links.
    @guidance
        -- HTTP: GET /new renders the form (visible labels, hints, an error
        -- summary with anchors on 422) with the repeats controls always in
        -- the markup: a Repeats checkbox, and behind it the seven weekday
        -- checkboxes, Times and Until, which the ticked checkbox reveals in
        -- CSS alone and a re-render after a 422 keeps in view. POST /new is
        -- described in CreateEvent and, when repeats=1 is sent, in
        -- CreateSeries. Anyone who is not a poster, anonymous
        -- included, gets 403.
}

surface EventEditor {
    facing curator: Poster

    context event: Event where poster = curator

    exposes:
        event.slug
        event.title
        event.starts_at
        event.venue
        event.price
        event.tags
        event.links
        event.description

    provides:
        EditEvent(curator, event, title, starts_at, venue, price?, description, tags, links)
        DeleteEvent(curator, event)

    related:
        EventDetail(event)

    @guarantee SlugImmutable
        -- Saving the editor never changes the slug; the same URL keeps working.
    @guidance
        -- HTTP: GET/POST /e/{slug}/edit and POST /e/{slug}/delete, owner only.

}

surface PwaAssets {
    facing visitor: Visitor

    @guarantee Installable
        -- Every HTML page declares a web app manifest, a viewport and a theme
        -- colour and registers a service worker; the manifest names the app,
        -- its start URL, display mode and icons, so browsers offer installation
        -- and the app opens offline to an offline page.
    @guarantee WorksWithoutScript
        -- Every feature is reachable with script disabled: all mutations are
        -- plain form posts answered with 303 redirects, and script only
        -- enhances toggles in place.
    @guidance
        -- HTTP: GET /manifest.webmanifest (application/manifest+json), GET
        -- /sw.js (text/javascript, no-cache), GET /icon.svg and
        -- /icon-{180,192,512}.png, GET /offline, GET /static/* with long-lived
        -- immutable caching under versioned URLs, GET /healthz answering
        -- "ok" as text/plain. HTML is never cached by the service worker.
        -- Unknown paths answer a 404 page, /login, /login/code and /logout
        -- among them; GET on a POST-only path answers 405.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- OQ-1 (tags) resolved by the founder on 2026-09-06: the fixed list is concert, theater,
-- film, exhibition (narrowed to these four on 2026-09-06). No catch-all tag: better to miss a
-- category than to have a bucket tag.
open question "OQ-2 Event fields: title, start date+time, venue (required), price (optional text), plain-text description, 1-4 tags, up to 3 labelled http(s) links, no end time and no media? (default: yes)"
open question "OQ-3 One post per event: is a duplicate defined as same poster + same normalised title + same Athens day, refused as already posted? (default: yes)"
open question "OQ-4 Past start dates: may a poster create or edit an event that already started? (default: yes, within one year back and three years ahead, for backfill)"
open question "OQ-5 Follow and hide: is the follower count public, and is hidden private to the account, keeping the event out of feeds until cleared from the event page or the Hidden section of /mine? (default: yes to both)"
open question "OQ-6 Delete account: is self-deletion limited to role user, cascading sessions and event follows, with curators removed by hand? (default: yes)"
open question "OQ-7 Delete event: hard delete with cascade of event follows and a slug that answers 404 forever? (default: yes)"
-- OQ-8 (one-time codes) withdrawn by the founder on 2026-09-06 together with the
-- email-only account default: there is no email anywhere. Accounts are anonymous,
-- start in a cookie on the first Follow of an event, and move between devices
-- through a secret link; posters log in with the secret link the CLI prints.
open question "OQ-9 Sessions: fixed 365-day lifetime without sliding renewal, carried in an HttpOnly SameSite=Lax cookie, with the secret link as the only way back after the cookie is lost? (default: yes)"
-- OQ-10 (CSRF) resolved with its default: a same-site session cookie plus a
-- fetch-metadata/origin check, no per-form token. See the AccountPage surface's
-- @guarantee CrossSiteWritesRejected.
open question "OQ-11 Form convention: success 303, validation failure 422 re-render, a session-only POST without a session 303 to /account, wrong role 403, GET on a POST-only route 405? (default: yes)"
open question "OQ-12 Time: store instants in UTC and treat every calendar boundary (feed start, duplicate check, slug date) in Europe/Athens? (default: yes)"
-- OQ-13 (theme) resolved by the founder on 2026-09-06: English copy, dark mode follows
-- the system by default AND a light/dark switch exists (rule ChooseTheme).
open question "OQ-14 PWA icon: is a generated SVG/PNG icon the sole exception to no images? (default: yes)"
open question "OQ-15 Packaging: single Go module dside.studio/events with SQLite as the only third-party dependency, deployed as a Docker image with a data volume? (default: yes)"
open question "OQ-16 Upcoming boundary: does an event stay upcoming until the end of its Athens day, or only until its start time? (default: until the Athens day ends, so today's earlier events still show in the feed and keep their Follow toggles)"
open question "OQ-17 Abuse: should cookieless POSTs creating accounts be rate-limited or should idle accounts be purged? (default: no, POC)"
open question "OQ-19 Reaching /mine: since the nav lost its mine link, a visitor whose event follows are all past or hidden has no link to /mine (Past, Hidden). Add one on /account? (default: yes, a plain link on the account page; not implemented until the founder agrees)"
open question "OQ-18 Key at rest: the secret key is stored in clear so the account page can show the link, which makes a copy of the database every login; acceptable for the POC, or should links be shown only once at creation and rotation with a hash at rest? (default: in clear, POC)"
-- OQ-20 (repeating events) resolved by the founder on 2026-09-06: a repeating post is
-- weekdays x start times x an until date, expanded to ordinary events sharing a series
-- id (rule CreateSeries, config.max_series_occurrences). Edit and delete stay per date;
-- follow, hide and clear act on the whole run (invariant SeriesFollowStateUniform). No
-- series page, no series edit.
